+    private @Nullable Path selectBestPath(final List<Map.Entry<Target, BlockPos>> targets, final boolean reached) {
+        if (targets.isEmpty()) {
+            return null;
+        }
+
+        Map.Entry<Target, BlockPos> best = targets.getFirst();
+        Node bestNode = best.getKey().getBestNode();
+        int bestLength = getNodeCount(bestNode);
+        float bestDistance = reached ? bestNode.distanceManhattan(best.getValue()) : 0.0F;
+
+        for (int i = 1; i < targets.size(); i++) {
+            Map.Entry<Target, BlockPos> candidate = targets.get(i);
+            Node node = candidate.getKey().getBestNode();
+            float distance = reached ? node.distanceManhattan(candidate.getValue()) : 0.0F;
+            int comparison = Float.compare(distance, bestDistance);
+            if (comparison > 0) {
+                continue;
+            }
+            int length = node == bestNode ? bestLength : getNodeCount(node);
+            if (comparison < 0 || length < bestLength) {
+                best = candidate;
+                bestNode = node;
+                bestLength = length;
+                bestDistance = distance;
+            }
+        }
+
+        return this.reconstructPath(bestNode, best.getValue(), reached, bestLength);
+    }
+
+    private static int getNodeCount(final Node closest) {
+        int count = 1;
+        for (Node node = closest; node.cameFrom != null; node = node.cameFrom) {
+            count++;
+        }
+        return count;
+    }
+
+    private Path reconstructPath(final Node closest, final BlockPos target, final boolean reached, final int nodeCount) {
+        List<Node> nodes = Lists.newArrayListWithCapacity(nodeCount);
+        for (Node node = closest; node != null; node = node.cameFrom) {
+            nodes.add(node);
+        }
+        Collections.reverse(nodes);
         return new Path(nodes, target, reached);
     }
