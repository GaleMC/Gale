     public int getSpawnLimit(final SpawnCategory spawnCategory, final World world) {
         final net.minecraft.world.level.Level level = ((CraftWorld) world).getHandle();
         final Integer worldLimit = level.spawnLimits.get(spawnCategory);
         return worldLimit != null ? worldLimit : this.getSpawnLimitUnsafe(spawnCategory);
     }
 
